# Apache only; Vercel uses /vercel.json instead.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the www host
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.swkpropertiesuae.com%{REQUEST_URI} [R=301,L]

# Old URLs -> new clean URLs
RewriteCond %{QUERY_STRING} (?:^|&)id=([^&]+)
RewriteRule ^property-details\.html$ /properties/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=([^&]+)
RewriteRule ^blog-post\.html$ /blog/%1/? [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^properties/(river-cove-residences|raw-district-2|golf-fields|villa-sanctuary|hills-grove-townhouse|islands-2|rise-by-athlon|arabian-ranches-courtyard-villa|marina-sky-penthouse|creek-harbour-waterside-townhouse|business-bay-executive-tower|hills-estate-golf-mansion|jvc-boulevard-residences|palm-garden-homes)/?$ /properties/ [R=301,L]
RewriteRule ^blog/research/ /blog/ [R=301,L]
RewriteRule ^blog/.+-residential-sales/?$ /blog/ [R=301,L]
RewriteRule ^(properties|about|services|mortgage|blog|contact)\.html$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(png|jpe?g|webp|svg|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
